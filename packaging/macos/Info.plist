<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The macOS file associations. src-tauri/tauri.conf.json names this file as bundle.macOS.infoPlist,
  and the Tauri bundler sets each key below over the Info.plist it writes, so these two lists replace
  the ones it renders from bundle.fileAssociations. They repeat every association tauri.conf.json
  declares, unchanged, and add the formats MolBioCraft opens that only macOS registers: Windows gives
  .pdb and .vcf to other programs. Set no other key here: it would replace the bundler's own.
  src/__tests__/releasePackaging.test.ts checks this file against tauri.conf.json.
-->
