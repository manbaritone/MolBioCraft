# Default: auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source Code, Scripts & Configs (strict LF across macOS, Windows & Linux)
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.jsonl   text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.rs      text eol=lf
*.toml    text eol=lf
*.lock    text eol=lf
*.cpp     text eol=lf
*.hpp     text eol=lf
*.mm      text eol=lf
*.py      text eol=lf
*.R       text eol=lf
*.sh      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf
*.tsv     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.cff     text eol=lf
*.version text eol=lf
*.svg     text eol=lf
*.plist   text eol=lf
*.wxs     text eol=lf
*.desktop text eol=lf

# Extensionless top-level docs & POSIX git hooks (must remain LF on Windows)
LICENSE                 text eol=lf
NOTICE                  text eol=lf
scripts/git-hooks/*     text eol=lf

# Text-based Bioinformatics Formats & Fixtures (LF)
*.fa      text eol=lf
*.fai     text eol=lf
*.fasta   text eol=lf
*.fq      text eol=lf
*.fastq   text eol=lf
*.gbk     text eol=lf
*.gb      text eol=lf
*.embl    text eol=lf
*.gff3    text eol=lf
*.bed     text eol=lf
*.sam     text eol=lf
*.vcf     text eol=lf
*.pdb     text eol=lf
*.cif     text eol=lf
*.nwk     text eol=lf
*.nex     text eol=lf
*.mbc     text eol=lf
*.amb     text eol=lf
*.ann     text eol=lf

# Windows Batch / Installer Scripts (CRLF required by cmd.exe / NSIS)
*.nsi     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary Bioinformatics Formats & BWA Index Files
*.ab1     binary
*.scf     binary
*.fsa     binary
*.bam     binary
*.bwt     binary
*.pac     binary
*.sa      binary

# Binary Assets, Fonts, WebAssembly & Installers
*.dmg      binary
*.pkg      binary
*.exe      binary
*.msi      binary
*.deb      binary
*.rpm      binary
*.AppImage binary
*.bundle   binary
*.dll      binary
*.dylib    binary
*.so       binary
*.icns     binary
*.ico      binary
*.png      binary
*.webp     binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.pdf      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.wasm     binary

# Generated / Lock / Reference-Data Files (collapse in GitHub diffs & exclude from language stats)
public/molbiocraft_wasm.wasm             linguist-generated=true
test-data/reference/*.json               linguist-generated=true
test-data/sim/**                         linguist-generated=true
crates/*/tests/ts_rpc_payloads.json      linguist-generated=true
package-lock.json                        linguist-generated=true
Cargo.lock                               linguist-generated=true
src-tauri/Cargo.lock                     linguist-generated=true

# Exclude internal SDLC, agent instruction & audit files from git archive / source tarballs
/sdlc-studio/**                          export-ignore
/AGENTS.md                               export-ignore
/CLAUDE.md                               export-ignore
/MOLBIOCRAFT_FUNCTIONAL_INTEGRITY_AUDIT.md   export-ignore
/MOLBIOCRAFT_RUST_PACKAGING_INTEGRITY_AUDIT.md export-ignore
/MOLBIOCRAFT_UI_UX_PERFORMANCE_REPORT.md export-ignore
/docs/audit/**                           export-ignore
